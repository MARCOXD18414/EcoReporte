# ---------- Servidor ----------
PORT=4000
# Orígenes permitidos (separados por coma). En dev Vite usa proxy, así que basta con localhost.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Firma de tokens de sesión (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Si existe ../frontend/dist, el backend también sirve la PWA (deploy único en DigitalOcean)
SERVE_FRONTEND=true

# ---------- Supabase (BD #1, nube) ----------
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Service role: SÓLO en el backend, nunca en el frontend
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=reportes

# ---------- IA ----------
# Orden de proveedores: google (Gemma 4 vía Gemini API) | ollama (Gemma 4 self-hosted) | heuristic
AI_PROVIDER=google
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verifica el ID exacto del modelo Gemma 4 disponible en AI Studio
GEMMA_MODEL=gemma-4-26b-a4b-it
# MINIMAL = respuestas en ~3 s (vacío para dejar que Gemma piense más)
GEMMA_THINKING=MINIMAL
AI_TIMEOUT_MS=45000
# Confianza mínima para pre-seleccionar combos automáticamente
AI_MIN_CONFIDENCE=0.55

# Opcional: Gemma 4 open-source en un Droplet de DigitalOcean con Ollama
# OLLAMA_URL=http://TU-DROPLET:11434
# OLLAMA_MODEL=gemma4
